{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dt-prototype:input:v1:weather-row",
  "title": "DT Prototype weather-row contract v1",
  "type": "object",
  "properties": {
    "weather_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "time": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "temperature_C": {
      "type": "number"
    },
    "ghi_Wm2": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "time",
    "temperature_C"
  ],
  "additionalProperties": false
}
